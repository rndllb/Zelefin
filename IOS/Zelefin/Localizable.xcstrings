    "Ask a server administrator to install the Zelefin plugin from Settings → Notifications, or sign in with an admin account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من مسؤول الخادم تثبيت إضافة Zelefin من الإعدادات ← الإشعارات، أو سجّل الدخول بحساب مسؤول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie einen Serveradministrator, das Zelefin-Plugin unter Einstellungen → Mitteilungen zu installieren, oder melden Sie sich mit einem Administratorkonto an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask a server administrator to install the Zelefin plugin from Settings → Notifications, or sign in with an admin account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a un administrador del servidor que instale el complemento Zelefin en Ajustes → Notificaciones, o inicia sesión con una cuenta de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à un administrateur d’installer le module Zelefin dans Réglages → Notifications, ou connectez-vous avec un compte administrateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर प्रशासक से सेटिंग्स → सूचनाएँ में Zelefin प्लगइन इंस्टॉल करने को कहें, या व्यवस्थापक खाते से साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta administrator server memasang plugin Zelefin dari Pengaturan → Notifikasi, atau masuk dengan akun administrator."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー管理者に、設定 → 通知から Zelefin プラグインをインストールしてもらうか、管理者アカウントでサインインしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça a um administrador do servidor para instalar o plugin Zelefin em Ajustes → Notificações, ou entre com uma conta de administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите администратора сервера установить плагин Zelefin в Настройки → Уведомления или войдите под учётной записью администратора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让服务器管理员从设置 → 通知安装 Zelefin 插件，或使用管理员账户登录。"
          }
        }
      }
    },
    "Ask an Administrator" : {

    },
    "Born %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُلد %@"
          }
