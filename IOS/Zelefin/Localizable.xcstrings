    "settings.featured_hero_footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يتنقّل فيه بطل الرئيسية وارتفاع خلفيات المميز وصفحة العنوان. المدمج يُظهر أكثر من المشهد الأفقي؛ الطويل هو الارتفاع السابق. المضاف حديثًا هو الافتراضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was der Home-Hero zeigt und wie hoch die Hintergründe sind. Kompakt zeigt mehr Querformat; Hoch ist die frühere Höhe. Zuletzt hinzugefügt ist Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the Home hero cycles through, and how tall the Featured and title-page backdrops run. Compact shows more of a landscape image; Tall is the previous full-bleed height. Recently Added is the default content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué recorre el héroe de Inicio y la altura de los fondos. Compacto muestra más paisaje; Alto es la altura anterior. Añadidos recientemente es el contenido por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que parcourt le héros d’accueil et la hauteur des fonds. Compact montre plus de paysage ; Grand est l’ancienne hauteur. Récemment ajoutés est le contenu par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम हीरो क्या दिखाए और Featured/शीर्षक पृष्ठ कितने ऊँचे हों। Compact में लैंडस्केप ज़्यादा दिखता है; Tall पुरानी पूरी ऊँचाई है। Recently Added डिफ़ॉल्ट है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang digulir hero Beranda dan tinggi latar. Ringkas menampilkan lebih banyak lanskap; Tinggi adalah tinggi sebelumnya. Baru Ditambahkan adalah default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームのヒーローに何を出すかと背景の高さ。コンパクトは横長が多め；高は以前の全高。最近追加が既定です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o herói da Home percorre e a altura dos fundos. Compacto mostra mais paisagem; Alto é a altura anterior. Adicionados recentemente é o padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что показывает герой на главной и высота фонов. Компактный показывает больше пейзажа; высокий — прежняя высота. Недавно добавленное — по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页主视觉轮播内容，以及精选和标题页背景高度。紧凑显示更多横向画面；高为原先全幅高度。默认内容为最近添加。"
          }
        }
      }
    },
