    "This Connection" : {

    },
    "This server can push lock-screen alerts while Zelefin is open or closed. Restart Jellyfin after you install or remove the plugin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع هذا الخادم دفع تنبيهات شاشة القفل سواء كان Zelefin مفتوحًا أو مغلقًا. أعد تشغيل Jellyfin بعد تثبيت الإضافة أو إزالتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server kann Sperrbildschirm-Hinweise senden, ob Zelefin offen oder geschlossen ist. Starten Sie Jellyfin neu, nachdem Sie das Plugin installiert oder entfernt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server can push lock-screen alerts while Zelefin is open or closed. Restart Jellyfin after you install or remove the plugin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor puede enviar alertas a la pantalla de bloqueo con Zelefin abierto o cerrado. Reinicia Jellyfin después de instalar o quitar el complemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur peut envoyer des alertes sur l’écran verrouillé, que Zelefin soit ouvert ou fermé. Redémarrez Jellyfin après avoir installé ou retiré le module."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सर्वर Zelefin खुला हो या बंद, लॉक स्क्रीन सूचनाएँ भेज सकता है। प्लगइन इंस्टॉल या हटाने के बाद Jellyfin पुनः आरंभ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ini dapat mengirim peringatan layar kunci saat Zelefin terbuka atau tertutup. Mulai ulang Jellyfin setelah memasang atau menghapus plugin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefin が開いていても閉じていても、このサーバーはロック画面の通知を送れます。プラグインのインストールまたは削除のあと Jellyfin を再起動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor pode enviar alertas para a tela bloqueada com o Zelefin aberto ou fechado. Reinicie o Jellyfin depois de instalar ou remover o plugin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер может присылать уведомления на экран блокировки, когда Zelefin открыт или закрыт. Перезапустите Jellyfin после установки или удаления плагина."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论 Zelefin 打开还是关闭，此服务器都可以推送锁屏提醒。安装或移除插件后请重启 Jellyfin。"
          }
        }
      }
    },
    "This server only keeps preset avatars. Custom photos need avatar storage on the Silo host." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ هذا الخادم بالصور الرمزية الجاهزة فقط. الصور المخصصة تحتاج تخزين الصور الرمزية على مضيف Silo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server behält nur vorgegebene Avatare. Eigene Fotos brauchen Avatar-Speicher auf dem Silo-Host."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server only keeps preset avatars. Custom photos need avatar storage on the Silo host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor solo guarda avatares predefinidos. Las fotos personalizadas necesitan almacenamiento de avatares en el host de Silo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne conserve que des avatars prédéfinis. Les photos personnalisées ont besoin d’un stockage d’avatars sur l’hôte Silo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सर्वर केवल पूर्वनिर्धारित अवतार रखता है। कस्टम फ़ोटो के लिए Silo होस्ट पर अवतार संग्रहण चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server ini hanya menyimpan avatar bawaan. Foto khusus memerlukan penyimpanan avatar di host Silo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは用意されたアバターだけを保持します。自分の写真には Silo ホストのアバター保存先が必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor só guarda avatares predefinidos. Fotos personalizadas precisam de armazenamento de avatares no host do Silo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер хранит только готовые аватары. Для своих фото нужно хранилище аватаров на узле Silo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器只保留预设头像。自定义照片需要 Silo 主机上的头像存储。"
          }
        }
      }
    },
    "This token signs this device into %@. Copy it only into apps you trust." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقّع هذا الرمز دخول هذا الجهاز إلى %@. انسخه فقط إلى تطبيقات تثق بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Token meldet dieses Gerät bei %@ an. Kopieren Sie es nur in Apps, denen Sie vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This token signs this device into %@. Copy it only into apps you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este token inicia la sesión de este dispositivo en %@. Cópialo solo en apps de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeton connecte cet appareil à %@. Ne le copiez que dans des apps de confiance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह टोकन इस डिवाइस को %@ में साइन इन करता है। इसे केवल उन्हीं ऐप में कॉपी करें जिन पर आप भरोसा करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ini memasukkan perangkat ini ke %@. Salin hanya ke aplikasi yang Anda percaya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトークンでこのデバイスが %@ にサインインします。信頼するアプリにだけコピーしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este token entra com este dispositivo em %@. Copie-o só para apps em que você confia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот токен выполняет вход устройства в %@. Копируйте его только в приложения, которым доверяете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此令牌让这台设备登录 %@。只把它复制到你信任的应用中。"
