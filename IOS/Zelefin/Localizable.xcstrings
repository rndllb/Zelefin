    "settings.sidebar_footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البحث والرئيسية واكتشف والمضاف حديثًا تبقى في الأعلى. أوقف مكتبة لإخفائها. انقر تعديل للسحب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche, Start, Entdecken und Zuletzt hinzugefügt bleiben oben. Bibliothek ausblenden. Bearbeiten zum Sortieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search, Home, Discover, and Recently Added always stay at the top. Turn off a library to hide it from the sidebar. Click Edit to drag libraries into a new order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar, Inicio, Descubrir y Añadidos recientemente siempre arriba. Desactiva una biblioteca para ocultarla. Editar para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche, Accueil, Découvrir et Récemment ajoutés restent en haut. Désactivez une bibliothèque pour la masquer. Modifier pour réordonner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search, Home, Discover और Recently Added ऊपर रहते हैं। लाइब्रेरी बंद करके साइडबार से छिपाएँ। Edit से क्रम बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari, Beranda, Temukan, dan Baru Ditambahkan selalu di atas. Matikan perpustakaan untuk menyembunyikan. Edit untuk menyeret."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索・ホーム・発見・最近追加は常に上部。ライブラリをオフで非表示。編集で並べ替え。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar, Início, Descobrir e Adicionados recentemente ficam no topo. Desative uma biblioteca para ocultar. Editar para reordenar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск, Главная, Обзор и Недавно добавленное всегда сверху. Отключите библиотеку, чтобы скрыть. Изменить — для порядка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索、首页、发现和最近添加始终置顶。关闭媒体库可从侧边栏隐藏。点编辑可拖动排序。"
          }
        }
      }
    },
