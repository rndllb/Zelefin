    "When on, shows other devices’ Now Playing on the Lock Screen. Off by default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التشغيل، يعرض ما يُشغَّل الآن على الأجهزة الأخرى على شاشة القفل. متوقف افتراضيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiv, zeigt die Wiedergabe anderer Geräte auf dem Sperrbildschirm. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, shows other devices’ Now Playing on the Lock Screen. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, muestra lo que se reproduce en otros dispositivos en la pantalla de bloqueo. Desactivado de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé, affiche la lecture en cours des autres appareils sur l’écran verrouillé. Désactivé par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर अन्य डिवाइस का अभी चल रहा लॉक स्क्रीन पर दिखाता है। डिफ़ॉल्ट रूप से बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat aktif, menampilkan Sedang diputar perangkat lain di Layar Kunci. Nonaktif secara bawaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、他のデバイスの再生中をロック画面に表示します。初期設定はオフです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ligado, mostra o que está tocando em outros dispositivos na tela bloqueada. Desligado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, показывает «Сейчас играет» других устройств на экране блокировки. По умолчанию выключено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，会在锁屏上显示其他设备的正在播放。默认关闭。"
          }
        }
      }
    },
    "When this Emby plugin is installed and signed in to an Open Subtitles account, use More on a movie or episode to search for subtitles and save a file to the server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تثبيت إضافة Emby هذه وتسجيل الدخول إلى حساب Open Subtitles، استخدم المزيد على فيلم أو حلقة للبحث عن ترجمات وحفظ ملف على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieses Emby-Plugin installiert und bei einem Open-Subtitles-Konto angemeldet ist, nutzen Sie Mehr bei einem Film oder einer Episode, um Untertitel zu suchen und eine Datei auf dem Server zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this Emby plugin is installed and signed in to an Open Subtitles account, use More on a movie or episode to search for subtitles and save a file to the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando este complemento de Emby está instalado y has iniciado sesión en una cuenta de Open Subtitles, usa Más en una película o episodio para buscar subtítulos y guardar un archivo en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand ce module Emby est installé et connecté à un compte Open Subtitles, utilisez Plus sur un film ou un épisode pour chercher des sous-titres et enregistrer un fichier sur le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब यह Emby प्लगइन इंस्टॉल हो और Open Subtitles खाते में साइन इन हो, तो फ़िल्म या एपिसोड पर अधिक से उपशीर्षक खोजें और सर्वर पर फ़ाइल सहेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat plugin Emby ini terpasang dan masuk ke akun Open Subtitles, gunakan Lainnya pada film atau episode untuk mencari takarir dan menyimpan berkas ke server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Emby プラグインをインストールして Open Subtitles にサインインしたら、映画やエピソードの「その他」から字幕を検索してサーバーに保存できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando este plugin do Emby está instalado e conectado a uma conta do Open Subtitles, use Mais em um filme ou episódio para buscar legendas e salvar um arquivo no servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда этот плагин Emby установлен и выполнен вход в Open Subtitles, используйте «Ещё» у фильма или серии, чтобы найти субтитры и сохранить файл на сервер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
