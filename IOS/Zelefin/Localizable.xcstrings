    "Capabilities" : {

    },
    "Caps how fast this user can pull video from outside the local network. Unlimited leaves the client in charge." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحد سرعة سحب هذا المستخدم للفيديو من خارج الشبكة المحلية. بلا حد يترك القرار للعميل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie schnell dieser Benutzer Video von außerhalb des lokalen Netzes laden kann. Unbegrenzt überlässt das dem Client."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caps how fast this user can pull video from outside the local network. Unlimited leaves the client in charge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la velocidad a la que este usuario puede recibir vídeo desde fuera de la red local. Ilimitado deja la decisión al cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la vitesse à laquelle cet utilisateur peut recevoir la vidéo hors du réseau local. Illimité laisse le client décider."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सीमित करता है कि यह उपयोगकर्ता स्थानीय नेटवर्क के बाहर से वीडियो कितनी तेज़ी से ले सकता है। असीमित होने पर नियंत्रण क्लाइंट के पास रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membatasi seberapa cepat pengguna ini dapat mengambil video dari luar jaringan lokal. Tanpa batas menyerahkan keputusan ke klien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このユーザーがローカルネットワークの外から動画を受信する速度の上限です。無制限ではクライアントが決めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita a velocidade com que este usuário pode receber vídeo de fora da rede local. Ilimitado deixa o cliente decidir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничивает скорость, с которой этот пользователь может получать видео вне локальной сети. «Без ограничений» оставляет решение клиенту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制此用户从本地网络之外拉取视频的速度。无限制则由客户端决定。"
          }
        }
      }
    },
