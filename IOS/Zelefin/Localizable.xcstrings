    "connect.quick_connect_help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Jellyfin على جهاز آخر مسجّل وادخل هذا الرمز ضمن Quick Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Jellyfin auf einem anderen angemeldeten Gerät und geben Sie diesen Code unter Quick Connect ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Jellyfin on another signed-in device and enter this code under Quick Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Jellyfin en otro dispositivo con sesión e introduce este código en Quick Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Jellyfin sur un autre appareil connecté et saisissez ce code dans Quick Connect."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी अन्य साइन-इन डिवाइस पर Jellyfin खोलें और Quick Connect में यह कोड दर्ज करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Jellyfin di perangkat lain yang sudah masuk dan masukkan kode ini di Quick Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のサインイン済みデバイスで Jellyfin を開き、クイック接続にこのコードを入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Jellyfin em outro dispositivo conectado e digite este código em Quick Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Jellyfin на другом устройстве и введите этот код в Quick Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台已登录设备上打开 Jellyfin，并在快速连接中输入此代码。"
          }
        }
      }
    },
    "connect.reset_password_help" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تعيين كلمة المرور على الخادم، أو اسأل من يديره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzen Sie Ihr Passwort auf dem Server zurück oder fragen Sie den Betreiber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset your password on the server, or ask the person who runs it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece tu contraseña en el servidor, o pregunta a quien lo administra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialisez votre mot de passe sur le serveur, ou demandez à l’administrateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर पर पासवर्ड रीसेट करें, या चलाने वाले से पूछें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur ulang kata sandi di server, atau tanya pengelolanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーでパスワードをリセットするか、管理者に聞いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefina sua senha no servidor, ou peça a quem o administra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросьте пароль на сервере или обратитесь к администратору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器上重置密码，或联系服务器管理员。"
          }
        }
      }
    },
