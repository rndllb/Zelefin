    "They will not be able to sign in until you turn the account back on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يستطيعوا تسجيل الدخول حتى تعيد تشغيل الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung ist nicht möglich, bis Sie das Konto wieder einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They will not be able to sign in until you turn the account back on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podrán iniciar sesión hasta que vuelvas a activar la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion restera impossible tant que vous ne réactiverez pas le compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप खाता वापस चालू नहीं करते वे साइन इन नहीं कर पाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka tidak dapat masuk sampai Anda mengaktifkan kembali akunnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを再びオンにするまでサインインできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não vão conseguir entrar até você reativar a conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они не смогут войти, пока вы снова не включите учётную запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你重新启用账户之前，他们将无法登录。"
          }
        }
      }
    },
    "This client does not accept remote control." : {
      "localizations" : {
