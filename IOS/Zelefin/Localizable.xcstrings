    },
    "Language and autoplay defaults live on the server. Caps and library access are changed from the dashboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعدادات اللغة والتشغيل التلقائي الافتراضية على الخادم. تُغيَّر الحدود والوصول إلى المكتبات من لوحة التحكم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache und automatische Wiedergabe liegen auf dem Server. Grenzen und Bibliothekszugriff ändern Sie im Dashboard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language and autoplay defaults live on the server. Caps and library access are changed from the dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores predeterminados de idioma y reproducción automática están en el servidor. Los límites y el acceso a bibliotecas se cambian desde el panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue et la lecture automatique par défaut sont sur le serveur. Les limites et l’accès aux bibliothèques se changent depuis le tableau de bord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाषा और ऑटोप्ले के डिफ़ॉल्ट सर्वर पर रहते हैं। सीमाएँ और लाइब्रेरी पहुँच डैशबोर्ड से बदली जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa dan putar otomatis bawaan ada di server. Batas dan akses perpustakaan diubah dari dasbor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語と自動再生の初期設定はサーバーにあります。上限とライブラリへのアクセスはダッシュボードで変更します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os padrões de idioma e reprodução automática ficam no servidor. Limites e acesso às bibliotecas são alterados no painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык и автовоспроизведение по умолчанию хранятся на сервере. Ограничения и доступ к библиотекам меняются в панели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言和自动播放的默认值保存在服务器上。上限和资料库访问在控制台中更改。"
          }
        }
      }
    },
