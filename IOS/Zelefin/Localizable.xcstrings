    "settings.tab_footer_base" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف تبويبًا لإخفائه. اضغط تعديل للسحب. على iPad أيضًا من أعلى الشريط الجانبي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab ausschalten zum Ausblenden. Tippen Sie auf Bearbeiten zum Sortieren. Auf dem iPad auch oben in der Seitenleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off a tab to hide it from the tab bar. Tap Edit to drag rows into a new order. On iPad, you can also tap Edit at the top of the sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva una pestaña para ocultarla. Toca Editar para reordenar. En iPad también en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez un onglet pour le masquer. Touchez Modifier pour réordonner. Sur iPad aussi en haut de la barre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैब बंद करके छिपाएँ। Edit से पंक्तियाँ खींचकर क्रम बदलें। iPad पर साइडबार के ऊपर भी Edit।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan tab untuk menyembunyikan. Ketuk Edit untuk menyeret urutan. Di iPad juga di atas sidebar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブをオフで非表示。編集で並べ替え。iPad ではサイドバー上部の編集も可。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative uma aba para ocultá-la. Toque em Editar para reordenar. No iPad também no topo da barra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите вкладку, чтобы скрыть. Нажмите Изменить для перетаскивания. На iPad — сверху боковой панели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭标签可从标签栏隐藏。点编辑可拖动排序。在 iPad 也可点侧边栏顶部的编辑。"
          }
        }
      }
    },
    "settings.tab_footer_names_off" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشريط السفلي يعرض أيقونات فقط. فعّل إظهار الأسماء. يتسع لـ 5 تبويبات بما فيها البحث. "
          }
        },
        "de" : {
