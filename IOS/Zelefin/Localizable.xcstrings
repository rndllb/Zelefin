    },
    "Reset clears the password on the server. Set Password stores the new one now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة التعيين تمسح كلمة المرور على الخادم. تعيين كلمة المرور يحفظ الجديدة الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurücksetzen löscht das Passwort auf dem Server. Passwort festlegen speichert das neue sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset clears the password on the server. Set Password stores the new one now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablecer borra la contraseña en el servidor. Establecer contraseña guarda la nueva ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialiser efface le mot de passe sur le serveur. Définir le mot de passe enregistre le nouveau tout de suite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रीसेट सर्वर पर पासवर्ड साफ़ करता है। पासवर्ड सेट करें नया पासवर्ड अभी सहेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur ulang menghapus kata sandi di server. Atur kata sandi menyimpan yang baru sekarang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセットはサーバー上のパスワードを消去します。パスワードを設定は新しいパスワードを今すぐ保存します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinir apaga a senha no servidor. Definir senha grava a nova agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сброс очищает пароль на сервере. «Задать пароль» сразу сохраняет новый."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置会清除服务器上的密码。设置密码会立即保存新密码。"
          }
        }
      }
    },
