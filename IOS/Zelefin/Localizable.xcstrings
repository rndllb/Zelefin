          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда этот плагин заполняет библиотеку сериалов, Zelefin показывает её как отдельную библиотеку YouTube: каналы и видео отдельно от фильмов и сериалов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
