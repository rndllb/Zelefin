    "ui.no_1_server_is_set_up_in_2_the_request_is_still" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعد خادم %1$@ في %2$@. يبقى الطلب محفوظًا ليراه مسؤول، لكن لا يُنزَّل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %2$@ ist kein %1$@-Server eingerichtet. Die Anfrage bleibt für einen Administrator gespeichert, aber es wird nichts heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No %1$@ server is set up in %2$@. The request is still saved for an admin to see, but nothing downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un servidor %1$@ configurado en %2$@. La solicitud se guarda para que la vea un administrador, pero no se descarga nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun serveur %1$@ n’est configuré dans %2$@. La demande est quand même enregistrée pour un administrateur, mais rien n’est téléchargé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ में कोई %1$@ सर्वर सेट नहीं है। अनुरोध प्रशासक के देखने के लिए सहेजा रहता है, पर कुछ डाउनलोड नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada server %1$@ yang diatur di %2$@. Permintaan tetap disimpan agar administrator melihatnya, tetapi tidak ada yang diunduh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ に %1$@ サーバーが設定されていません。リクエストは管理者が見られるよう保存されますが、何もダウンロードされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum servidor %1$@ está configurado em %2$@. O pedido continua salvo para um administrador ver, mas nada é baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер %1$@ не настроен в %2$@. Запрос всё равно сохраняется для администратора, но ничего не загружается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未在 %2$@ 中设置 %1$@ 服务器。请求仍会保存给管理员查看，但不会下载任何内容。"
          }
        }
      }
    },
