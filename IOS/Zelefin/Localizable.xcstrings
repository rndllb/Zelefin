    "Turn off All Libraries to pick which folders this user can see." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف كل المكتبات لاختيار المجلدات التي يستطيع هذا المستخدم رؤيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie Alle Bibliotheken aus, um die Ordner zu wählen, die dieser Benutzer sehen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off All Libraries to pick which folders this user can see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Todas las bibliotecas para elegir qué carpetas puede ver este usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez Toutes les bibliothèques pour choisir les dossiers que cet utilisateur peut voir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह उपयोगकर्ता कौन से फ़ोल्डर देख सकता है चुनने के लिए सभी लाइब्रेरी बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan Semua perpustakaan untuk memilih folder yang dapat dilihat pengguna ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのライブラリをオフにして、このユーザーが見られるフォルダを選びます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative Todas as bibliotecas para escolher quais pastas este usuário pode ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите «Все библиотеки», чтобы выбрать папки, которые видит этот пользователь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“所有资料库”以选择此用户可以查看的文件夹。"
          }
        }
      }
