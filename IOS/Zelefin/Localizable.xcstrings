    "settings.scan_libraries_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبحث Jellyfin عن ملفات جديدة ويحدّث البيانات الوصفية. قد يستغرق ذلك وقتًا على خادم كبير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin sucht neue Dateien und aktualisiert Metadaten. Auf großen Servern kann das dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin will look for new files and refresh metadata. This can take a while on a large server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin buscará archivos nuevos y actualizará metadatos. Puede tardar en un servidor grande."
