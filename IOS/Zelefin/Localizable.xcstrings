    "Already requested or available seasons stay off. Specials stay off unless you turn them on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المواسم المطلوبة أو المتوفرة متوقفة. تبقى الحلقات الخاصة متوقفة ما لم تفعّلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits angeforderte oder vorhandene Staffeln bleiben aus. Specials bleiben aus, bis Sie sie einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already requested or available seasons stay off. Specials stay off unless you turn them on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las temporadas ya solicitadas o disponibles siguen desactivadas. Los especiales siguen desactivados salvo que los actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les saisons déjà demandées ou disponibles restent désactivées. Les hors-séries restent désactivés, sauf si vous les activez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से अनुरोधित या उपलब्ध सीज़न बंद रहते हैं। स्पेशल तब तक बंद रहते हैं जब तक आप उन्हें चालू न करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musim yang sudah diminta atau tersedia tetap nonaktif. Episode spesial tetap nonaktif kecuali Anda mengaktifkannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにリクエスト済み、または入手済みのシーズンはオフのままです。スペシャルはオンにしない限りオフです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporadas já pedidas ou disponíveis ficam desligadas. Especiais ficam desligados, a menos que você os ative."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже запрошенные или доступные сезоны остаются выключенными. Спецвыпуски выключены, пока вы их не включите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已点播或已有的季保持关闭。特别篇默认关闭，除非你打开。"
          }
        }
      }
    },
