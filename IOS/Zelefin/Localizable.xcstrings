    },
    "Jellyfin clears the password. They set a new one the next time they sign in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح Jellyfin كلمة المرور. يضعون كلمة جديدة في المرة التالية التي يسجّلون فيها الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin löscht das Passwort. Beim nächsten Anmelden wird ein neues festgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin clears the password. They set a new one the next time they sign in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin borra la contraseña. La persona elige una nueva la próxima vez que inicie sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin efface le mot de passe. La personne en choisit un nouveau à la prochaine connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin पासवर्ड साफ़ कर देता है। वे अगली बार साइन इन करते समय नया पासवर्ड सेट करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin menghapus kata sandi. Mereka mengatur yang baru saat masuk berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin がパスワードを消去します。次回サインインするときに新しいパスワードを設定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jellyfin apaga a senha. A pessoa define uma nova na próxima vez que entrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin сбрасывает пароль. Новый задают при следующем входе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin 会清除密码。对方下次登录时设置新密码。"
          }
        }
      }
    },
