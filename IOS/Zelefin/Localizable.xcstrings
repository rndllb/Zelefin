    "settings.language_footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحكم في قوائم وتسميات Zelefin. تبقى لغة الصوت والترجمة تحت التشغيل. النظام يتبع لغة الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert Menüs und Beschriftungen von Zelefin. Audio- und Untertitelsprache bleiben unter Wiedergabe. System folgt der Gerätesprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls Zelefin’s menus and labels. Audio and subtitle language stay under Playback. System follows the device language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla los menús y etiquetas de Zelefin. El idioma de audio y subtítulos sigue en Reproducción. Sistema sigue el idioma del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle les menus et libellés de Zelefin. Les langues audio et sous-titres restent dans Lecture. Système suit la langue de l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefin के मेनू और लेबल नियंत्रित करता है। ऑडियो और उपशीर्षक भाषा प्लेबैक में रहती है। सिस्टम डिवाइस भाषा का अनुसरण करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur menu dan label Zelefin. Bahasa audio dan subtitle tetap di Pemutaran. Sistem mengikuti bahasa perangkat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefinのメニューとラベルを制御します。音声・字幕の言語は再生設定のままです。システムは端末の言語に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla menus e rótulos do Zelefin. Idioma de áudio e legendas continua em Reprodução. Sistema segue o idioma do aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет меню и подписями Zelefin. Язык звука и субтитров — в разделе «Воспроизведение». «Системный» следует языку устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 Zelefin 的菜单和标签。音轨与字幕语言仍在“播放”中设置。系统跟随设备语言。"
          }
        }
      }
    },
