    "Email attaches the full log. GitHub opens a prefilled issue; attach the log there if the form is too short, or send it by email." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفق البريد السجل الكامل. يفتح GitHub بلاغًا معبّأً مسبقًا؛ أرفق السجل هناك إذا كان النموذج قصيرًا، أو أرسله بالبريد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die E-Mail hängt das vollständige Protokoll an. GitHub öffnet einen vorausgefüllten Bericht; hängen Sie das Protokoll dort an, wenn das Formular zu kurz ist, oder senden Sie es per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email attaches the full log. GitHub opens a prefilled issue; attach the log there if the form is too short, or send it by email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El correo adjunta el registro completo. GitHub abre un informe ya rellenado; adjunta el registro allí si el formulario es demasiado corto, o envíalo por correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’e-mail joint le journal complet. GitHub ouvre un ticket prérempli ; joignez le journal si le formulaire est trop court, ou envoyez-le par e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल पूरा लॉग संलग्न करता है। GitHub पहले से भरा मुद्दा खोलता है; यदि फ़ॉर्म छोटा हो तो वहाँ लॉग संलग्न करें, या ईमेल से भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email melampirkan log lengkap. GitHub membuka laporan yang sudah terisi; lampirkan log di sana jika formulir terlalu pendek, atau kirim lewat email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールには完全なログが添付されます。GitHub は入力済みの Issue を開きます。フォームが短いときはそこにログを添付するか、メールで送ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O e-mail anexa o registro completo. O GitHub abre um relato preenchido; anexe o registro lá se o formulário for curto demais, ou envie por e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо прикладывает полный журнал. GitHub открывает заполненную заявку; приложите журнал там, если форма слишком короткая, или отправьте его по почте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电子邮件会附上完整日志。GitHub 会打开已填写的问题；如果表格太短，请在那里附上日志，或通过电子邮件发送。"
          }
        }
      }
    },
    "Emby's branding is read-only here. Change it in Emby's web dashboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هوية Emby هنا للقراءة فقط. غيّرها في لوحة Emby على الويب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embys Erscheinungsbild ist hier schreibgeschützt. Ändern Sie es im Web-Dashboard von Emby."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby's branding is read-only here. Change it in Emby's web dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de Emby es de solo lectura aquí. Cámbiala en el panel web de Emby."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité visuelle d’Emby est en lecture seule ici. Modifiez-la dans le tableau de bord web d’Emby."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby की ब्रांडिंग यहाँ केवल पढ़ने के लिए है। इसे Emby के वेब डैशबोर्ड में बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merek Emby di sini hanya bisa dibaca. Ubah di dasbor web Emby."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby のブランディングはここでは読み取り専用です。Emby のウェブ管理画面で変更してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade visual do Emby é somente leitura aqui. Altere-a no painel web do Emby."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оформление Emby здесь только для чтения. Измените его в веб-панели Emby."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处的 Emby 品牌为只读。请在 Emby 的网页控制台中修改。"
          }
        }
      }
    },
    "Everything Zelefin has noted so far is removed from this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحذف من هذا الجهاز كل ما سجّله Zelefin حتى الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Zelefin bisher notiert hat, wird von diesem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything Zelefin has noted so far is removed from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que Zelefin ha anotado hasta ahora se elimina de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que Zelefin a noté jusqu’ici est supprimé de cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefin ने अब तक जो नोट किया है वह इस डिवाइस से हटा दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
