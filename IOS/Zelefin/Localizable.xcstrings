    "settings.about_body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عميل أصلي لـ Jellyfin وSilo وEmby — مجاني بلا اشتراك ولا إعلانات."
          }
        },
        "de" : {
          "stringUnit" : {
