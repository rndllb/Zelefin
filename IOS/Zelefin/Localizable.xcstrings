    "Device Token" : {

    },
    "Discover title pages show a title's logo when it's in your library. With a free TMDB key, from Settings → API on themoviedb.org, every other title shows its logo too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض صفحات الاستكشاف شعار العنوان عندما يكون في مكتبتك. بمفتاح TMDB مجاني من الإعدادات ← API على themoviedb.org، تعرض بقية العناوين شعارها أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecken-Seiten zeigen das Logo eines Titels, wenn er in Ihrer Mediathek ist. Mit einem kostenlosen TMDB-Schlüssel unter Einstellungen → API auf themoviedb.org zeigen auch die anderen Titel ihr Logo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discover title pages show a title's logo when it's in your library. With a free TMDB key, from Settings → API on themoviedb.org, every other title shows its logo too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas de Descubrir muestran el logo de un título cuando está en tu biblioteca. Con una clave gratuita de TMDB, en Ajustes → API de themoviedb.org, los demás títulos también muestran su logo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages Découvrir affichent le logo d’un titre s’il est dans votre bibliothèque. Avec une clé TMDB gratuite, dans Réglages → API sur themoviedb.org, les autres titres affichent aussi leur logo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्कवर पृष्ठ लाइब्रेरी में मौजूद शीर्षक का लोगो दिखाते हैं। themoviedb.org पर सेटिंग्स → API से मुफ़्त TMDB कुंजी के साथ बाकी शीर्षक भी अपना लोगो दिखाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halaman Temukan menampilkan logo judul jika judul itu ada di perpustakaan Anda. Dengan kunci TMDB gratis, dari Pengaturan → API di themoviedb.org, judul lain juga menampilkan logonya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見つけるページでは、ライブラリにある作品のロゴを表示します。themoviedb.org の設定 → API で無料の TMDB キーを入れると、それ以外の作品もロゴを表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas de Descobrir mostram o logo de um título quando ele está na sua biblioteca. Com uma chave gratuita do TMDB, em Ajustes → API em themoviedb.org, os outros títulos também mostram o logo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страницы «Обзор» показывают логотип названия, если оно есть в библиотеке. С бесплатным ключом TMDB (Настройки → API на themoviedb.org) логотип появляется и у остальных названий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现页会在标题已在你的资料库中时显示其标志。在 themoviedb.org 的设置 → API 获取免费 TMDB 密钥后，其他标题也会显示标志。"
          }
        }
      }
    },
    "Download" : {

    },
    "Downloads from Open Subtitles onto this Jellyfin server. Perfect match uses the file hash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل من Open Subtitles إلى خادم Jellyfin هذا. التطابق التام يستخدم بصمة الملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt von Open Subtitles auf diesen Jellyfin-Server. Ein perfekter Treffer nutzt den Datei-Hash."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads from Open Subtitles onto this Jellyfin server. Perfect match uses the file hash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga desde Open Subtitles a este servidor Jellyfin. La coincidencia perfecta usa el hash del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge depuis Open Subtitles sur ce serveur Jellyfin. La correspondance parfaite utilise l’empreinte du fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Subtitles से इस Jellyfin सर्वर पर डाउनलोड करता है। सटीक मिलान फ़ाइल हैश का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengunduh dari Open Subtitles ke server Jellyfin ini. Kecocokan sempurna memakai hash berkas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Subtitles からこの Jellyfin サーバーへダウンロードします。完全一致はファイルのハッシュを使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa do Open Subtitles para este servidor Jellyfin. A correspondência perfeita usa o hash do arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает с Open Subtitles на этот сервер Jellyfin. Точное совпадение использует хеш файла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Open Subtitles 下载到此 Jellyfin 服务器。完全匹配使用文件哈希。"
          }
        }
      }
    },
