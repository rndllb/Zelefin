    "settings.home_footer_merged" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناوين الجارية والحلقة التالية تظهر في صف متابعة واحد. ما زال كل عنوان يُوسم متابعة أو التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Titel und die nächste Folge erscheinen in einer Weitersehen-Zeile. Jeder Titel bleibt WEITER oder NÄCHSTE."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In-progress titles and the next episode after you finish one appear in a single Continue Watching row. Each title is still labeled CONTINUE or NEXT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los títulos en curso y el siguiente episodio aparecen en una sola fila Seguir viendo. Siguen etiquetados CONTINUAR o SIGUIENTE."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres en cours et l’épisode suivant apparaissent dans une seule rangée Continuer. Chaque titre reste CONTINUER ou SUIVANT."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी शीर्षक और अगला एपिसोड एक Continue Watching पंक्ति में। हर शीर्षक CONTINUE या NEXT लेबल रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judul berjalan dan episode berikutnya muncul di satu baris Lanjutkan. Masih berlabel LANJUTKAN atau BERIKUTNYA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中と次の話は1つの続きから見る行に。各タイトルはCONTINUEまたはNEXTのまま。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos em andamento e o próximo episódio aparecem numa única linha Continuar. Cada um ainda é CONTINUAR ou PRÓXIMO."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие и следующий эпизод — в одном ряду «Продолжить». У каждого по-прежнему метка ПРОДОЛЖИТЬ или ДАЛЕЕ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进行中的标题和下一集出现在同一“继续观看”行。每项仍标为继续或下一集。"
          }
        }
      }
    },
    "settings.home_footer_split" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ الجارية في متابعة المشاهدة والحلقة التالية في التالي."
          }
        },
        "de" : {
          "stringUnit" : {
