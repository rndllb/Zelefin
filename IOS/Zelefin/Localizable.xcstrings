            "value" : "行をオフにしてホームから非表示。%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative uma linha para ocultá-la da Home. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
