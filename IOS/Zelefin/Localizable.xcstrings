          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭某行可从首页隐藏。%@"
          }
        }
      }
    },
    "settings.home_rows_footer_custom" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفوف المخصصة تستخدم عوامل تصفية الكتالوج ويمكن وضعها بين الصفوف المدمجة. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Zeilen nutzen Katalogfilter und können zwischen den Standardzeilen stehen. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom rows use catalog filters and can sit between built-in rows. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las filas personalizadas usan filtros del catálogo y pueden ir entre las integradas. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rangées perso utilisent des filtres du catalogue et peuvent s’intercaler. "
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कस्टम पंक्तियाँ कैटलॉग फ़िल्टर उपयोग करती हैं और अंतर्निहित पंक्तियों के बीच हो सकती हैं। "
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris khusus memakai filter katalog dan bisa di antara baris bawaan. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム行はカタログフィルタを使い、標準行の間に置けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linhas personalizadas usam filtros do catálogo e podem ficar entre as integradas. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свои ряды используют фильтры каталога и могут стоять между встроенными. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义行使用目录筛选，可插在内置行之间。"
          }
        }
      }
    },
    "settings.home_rows_footer_next_up" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " يظهر التالي فقط عند إيقاف دمج متابعة المشاهدة والتالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Als Nächstes erscheint nur, wenn Zusammenführen aus ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Next Up only appears when Combine Continue Watching and Next Up is off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " A continuación solo aparece si Combinar Seguir viendo y A continuación está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " À suivre n’apparaît que si Combiner Continuer et À suivre est désactivé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Next Up तभी दिखता है जब Combine Continue Watching and Next Up बंद हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Berikutnya hanya muncul saat Gabungkan Lanjutkan dan Berikutnya dimatikan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 次に見るは「続きから見ると次に見るを結合」がオフのときだけ表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " A seguir só aparece quando Combinar Continuar e A seguir está desligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " «Далее» видно, только если объединение «Продолжить» и «Далее» выключено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
