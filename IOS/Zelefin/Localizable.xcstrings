    "Administrators can change photos, permissions, library access, and parental controls on this Jellyfin server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمسؤولين تغيير الصور والأذونات والوصول إلى المكتبات والرقابة الأبوية على خادم Jellyfin هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratoren können Fotos, Rechte, Bibliothekszugriff und Jugendschutz auf diesem Jellyfin-Server ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrators can change photos, permissions, library access, and parental controls on this Jellyfin server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los administradores pueden cambiar fotos, permisos, acceso a bibliotecas y controles parentales en este servidor Jellyfin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les administrateurs peuvent modifier les photos, les droits, l’accès aux bibliothèques et le contrôle parental sur ce serveur Jellyfin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रशासक इस Jellyfin सर्वर पर फ़ोटो, अनुमतियाँ, लाइब्रेरी पहुँच और अभिभावक नियंत्रण बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator dapat mengubah foto, izin, akses perpustakaan, dan kontrol orang tua di server Jellyfin ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者はこの Jellyfin サーバーで写真、権限、ライブラリへのアクセス、保護者による制限を変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administradores podem alterar fotos, permissões, acesso às bibliotecas e controle parental neste servidor Jellyfin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администраторы могут менять фото, права, доступ к библиотекам и родительский контроль на этом сервере Jellyfin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员可以在此 Jellyfin 服务器上更改照片、权限、资料库访问和家长控制。"
          }
        }
      }
    },
    "Administrators can change this user's profile picture on the server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمسؤولين تغيير صورة الملف الشخصي لهذا المستخدم على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratoren können das Profilbild dieses Benutzers auf dem Server ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrators can change this user's profile picture on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los administradores pueden cambiar la foto de perfil de este usuario en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les administrateurs peuvent changer la photo de profil de cet utilisateur sur le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रशासक सर्वर पर इस उपयोगकर्ता की प्रोफ़ाइल तस्वीर बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator dapat mengubah foto profil pengguna ini di server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者はサーバー上でこのユーザーのプロフィール写真を変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administradores podem alterar a foto de perfil deste usuário no servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администраторы могут сменить фото профиля этого пользователя на сервере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员可以在服务器上更改此用户的头像。"
          }
        }
      }
    },
    "Administrators can manage users, sessions, and server settings. Edit Subtitles lets this user search and download subtitles onto the server, same as an administrator." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمسؤولين إدارة المستخدمين والجلسات وإعدادات الخادم. يتيح تعديل الترجمات لهذا المستخدم البحث عن الترجمات وتنزيلها إلى الخادم، مثل المسؤول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratoren verwalten Benutzer, Sitzungen und Servereinstellungen. Untertitel bearbeiten lässt diesen Benutzer wie ein Administrator Untertitel suchen und auf den Server laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrators can manage users, sessions, and server settings. Edit Subtitles lets this user search and download subtitles onto the server, same as an administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los administradores pueden gestionar usuarios, sesiones y ajustes del servidor. Editar subtítulos permite a este usuario buscar y descargar subtítulos en el servidor, igual que un administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les administrateurs gèrent les utilisateurs, les sessions et les réglages du serveur. Modifier les sous-titres permet à cet utilisateur d’en chercher et d’en télécharger sur le serveur, comme un administrateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रशासक उपयोगकर्ता, सत्र और सर्वर सेटिंग प्रबंधित कर सकते हैं। उपशीर्षक संपादित करने से यह उपयोगकर्ता प्रशासक की तरह सर्वर पर उपशीर्षक खोज और डाउनलोड कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrator dapat mengelola pengguna, sesi, dan pengaturan server. Edit Takarir mengizinkan pengguna ini mencari dan mengunduh takarir ke server, sama seperti administrator."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者はユーザー、セッション、サーバー設定を管理できます。字幕の編集を許可すると、このユーザーは管理者と同様にサーバー上で字幕を検索してダウンロードできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administradores podem gerenciar usuários, sessões e ajustes do servidor. Editar legendas permite que este usuário pesquise e baixe legendas no servidor, como um administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администраторы управляют пользователями, сеансами и настройками сервера. Право «Редактировать субтитры» позволяет этому пользователю искать и загружать субтитры на сервер, как администратору."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员可以管理用户、会话和服务器设置。编辑字幕允许此用户像管理员一样在服务器上搜索并下载字幕。"
          }
        }
      }
    },
