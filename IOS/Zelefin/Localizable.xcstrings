    "detail.delete_files_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيزيل Jellyfin هذا العنصر وملفاته من الخادم. لا يمكن التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin entfernt dieses Element und seine Dateien vom Server. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin will remove this item and its files from the server. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin eliminará este elemento y sus archivos del servidor. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin retirera cet élément et ses fichiers du serveur. Irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin इस आइटम और इसकी फ़ाइलें सर्वर से हटा देगा। यह पूर्ववत नहीं हो सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin akan menghapus item ini dan filenya dari server. Tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin がこの項目とそのファイルをサーバーから削除します。元に戻せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jellyfin removerá este item e seus arquivos do servidor. Não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin удалит этот элемент и его файлы с сервера. Отменить нельзя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin 将从服务器移除此项目及其文件。此操作无法撤销。"
          }
        }
      }
    },
