    "Describe the problem in a sentence or two. The device log and diagnostics are included automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صف المشكلة في جملة أو اثنتين. يُرفق سجل الجهاز والتشخيص تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreiben Sie das Problem in ein oder zwei Sätzen. Geräteprotokoll und Diagnose werden automatisch beigefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the problem in a sentence or two. The device log and diagnostics are included automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe el problema en una o dos frases. El registro del dispositivo y el diagnóstico se incluyen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez le problème en une ou deux phrases. Le journal de l’appareil et les diagnostics sont joints automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या को एक या दो वाक्यों में बताएँ। डिवाइस लॉग और निदान अपने आप शामिल होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan masalahnya dalam satu atau dua kalimat. Log perangkat dan diagnostik disertakan secara otomatis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題を一、二文で書いてください。デバイスのログと診断情報は自動で添付されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva o problema em uma ou duas frases. O registro do dispositivo e o diagnóstico são incluídos automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишите проблему в одном-двух предложениях. Журнал устройства и диагностика прилагаются автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一两句话描述问题。设备日志和诊断信息会自动附上。"
          }
        }
      }
    },
