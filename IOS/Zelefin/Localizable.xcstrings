    "Jellyfin will restart and replace the current database with this archive. This cannot be undone from the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيعيد Jellyfin التشغيل ويستبدل قاعدة البيانات الحالية بهذا الأرشيف. لا يمكن التراجع عن ذلك من التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin startet neu und ersetzt die aktuelle Datenbank durch dieses Archiv. Das lässt sich in der App nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin will restart and replace the current database with this archive. This cannot be undone from the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin se reiniciará y sustituirá la base de datos actual por este archivo. No se puede deshacer desde la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin va redémarrer et remplacer la base actuelle par cette archive. Impossible d’annuler depuis l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin पुनः आरंभ होगा और वर्तमान डेटाबेस को इस संग्रह से बदल देगा। इसे ऐप से पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin akan dimulai ulang dan mengganti basis data saat ini dengan arsip ini. Ini tidak dapat dibatalkan dari aplikasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin が再起動し、現在のデータベースをこのアーカイブで置き換えます。アプリから元に戻すことはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jellyfin vai reiniciar e substituir o banco de dados atual por este arquivo. Isso não pode ser desfeito no app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin перезапустится и заменит текущую базу этим архивом. Отменить это в приложении нельзя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin 将重启，并用此归档替换当前数据库。无法在应用中撤销。"
          }
        }
      }
    },
