    "Use 4 to 6 digits. This PIN stays on this device and is asked before someone can sign into this account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم من 4 إلى 6 أرقام. يبقى رمز PIN هذا على هذا الجهاز ويُطلب قبل أن يسجّل أحد الدخول إلى هذا الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie 4 bis 6 Ziffern. Diese PIN bleibt auf diesem Gerät und wird abgefragt, bevor sich jemand bei diesem Konto anmeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 4 to 6 digits. This PIN stays on this device and is asked before someone can sign into this account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa de 4 a 6 dígitos. Este PIN se queda en este dispositivo y se pide antes de que alguien inicie sesión en esta cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez 4 à 6 chiffres. Ce PIN reste sur cet appareil et est demandé avant qu’une personne se connecte à ce compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 से 6 अंक उपयोग करें। यह PIN इस डिवाइस पर रहता है और इस खाते में साइन इन से पहले पूछा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan 4 sampai 6 digit. PIN ini tetap di perangkat ini dan diminta sebelum seseorang masuk ke akun ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 から 6 桁を使います。この PIN はこのデバイスに残り、このアカウントにサインインする前に聞かれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use de 4 a 6 dígitos. Este PIN fica neste dispositivo e é pedido antes de alguém entrar nesta conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте от 4 до 6 цифр. Этот PIN хранится на устройстве и запрашивается перед входом в эту учётную запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 4 到 6 位数字。此 PIN 保存在这台设备上，有人登录此账户前会要求输入。"
          }
        }
      }
    },
