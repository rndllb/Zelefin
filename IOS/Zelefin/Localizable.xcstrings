    "settings.poster_badges_footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نجوم التقييم وعلامات 4K/HDR/Atmos وعلامة المشاهدة على الملصقات. أوقف أيًا منها لتهدئة الأغلفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterne, 4K/HDR/Atmos-Marken und Gesehen-Haken auf Postern. Beliebige abschalten für ruhigere Cover."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rating stars, 4K/HDR/Atmos marks, and the watched check on posters. Turn any of them off to quiet the covers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrellas, marcas 4K/HDR/Atmos y el visto en pósteres. Desactiva cualquiera para simplificar las portadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étoiles, badges 4K/HDR/Atmos et coche vu sur les affiches. Désactivez-en pour alléger les jaquettes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्टर पर रेटिंग तारे, 4K/HDR/Atmos चिह्न और देखा गया चेक। शांत कवर के लिए कोई भी बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bintang rating, tanda 4K/HDR/Atmos, dan cek ditonton di poster. Matikan yang tidak perlu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポスターの評価星、4K/HDR/Atmos、視聴済み印。不要なものはオフに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrelas, marcas 4K/HDR/Atmos e visto nos pôsteres. Desative qualquer um para acalmar as capas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды рейтинга, метки 4K/HDR/Atmos и отметка просмотра. Отключите лишнее, чтобы упростить обложки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海报上的评分星、4K/HDR/Atmos 标记和已看勾选。关闭任意一项可减少干扰。"
          }
        }
      }
    },
