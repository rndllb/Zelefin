  "strings" : {
    "#" : {

    },
    "%@" : {

    },
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ appears as its own YouTube library, with channels and videos kept apart from your movies and shows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر %@ كمكتبة YouTube مستقلة، مع إبقاء القنوات والفيديوهات بعيدًا عن أفلامك ومسلسلاتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erscheint als eigene YouTube-Mediathek. Kanäle und Videos bleiben von Filmen und Serien getrennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ appears as its own YouTube library, with channels and videos kept apart from your movies and shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aparece como su propia biblioteca de YouTube, con canales y vídeos aparte de tus películas y series."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ apparaît comme sa propre bibliothèque YouTube, avec les chaînes et les vidéos à part de vos films et séries."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अपनी YouTube लाइब्रेरी के रूप में दिखता है, चैनल और वीडियो आपकी फ़िल्मों और शो से अलग रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muncul sebagai perpustakaan YouTube sendiri, dengan saluran dan video terpisah dari film dan acara Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は独自の YouTube ライブラリとして表示され、チャンネルと動画は映画や番組とは分けられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aparece como a própria biblioteca do YouTube, com canais e vídeos separados dos seus filmes e séries."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отображается как отдельная библиотека YouTube: каналы и видео отдельно от фильмов и сериалов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会作为单独的 YouTube 资料库显示，频道和视频与电影、剧集分开。"
          }
        }
      }
    },
    "%@ stored the file on the server. The subtitle list on this title is updated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفظ %@ الملف على الخادم. تم تحديث قائمة الترجمات لهذا العنوان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Datei auf dem Server gespeichert. Die Untertitelliste dieses Titels ist aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stored the file on the server. The subtitle list on this title is updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ guardó el archivo en el servidor. La lista de subtítulos de este título está actualizada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a enregistré le fichier sur le serveur. La liste des sous-titres de ce titre est à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने फ़ाइल सर्वर पर रख दी है। इस शीर्षक की उपशीर्षक सूची अपडेट हो गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menyimpan berkas di server. Daftar takarir judul ini sudah diperbarui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がファイルをサーバーに保存しました。この作品の字幕一覧を更新しました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ guardou o arquivo no servidor. A lista de legendas deste título foi atualizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сохранил файл на сервере. Список субтитров этого названия обновлён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已把文件保存到服务器。此标题的字幕列表已更新。"
          }
        }
      }
    },
    "%@%%" : {

    },
    "A backup archives this server’s database and metadata. Restoring one restarts Jellyfin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحفظ النسخة الاحتياطية قاعدة بيانات هذا الخادم وبياناته الوصفية. استعادتها تعيد تشغيل Jellyfin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sicherung archiviert Datenbank und Metadaten dieses Servers. Das Wiederherstellen startet Jellyfin neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup archives this server’s database and metadata. Restoring one restarts Jellyfin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia archiva la base de datos y los metadatos de este servidor. Restaurarla reinicia Jellyfin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde archive la base de données et les métadonnées de ce serveur. La restaurer redémarre Jellyfin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप इस सर्वर का डेटाबेस और मेटाडेटा संग्रहित करता है। उसे पुनर्स्थापित करने पर Jellyfin पुनः आरंभ होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan mengarsipkan basis data dan metadata server ini. Memulihkannya akan memulai ulang Jellyfin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップはこのサーバーのデータベースとメタデータを保存します。復元すると Jellyfin が再起動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup arquiva o banco de dados e os metadados deste servidor. Restaurá-lo reinicia o Jellyfin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия сохраняет базу данных и метаданные этого сервера. Восстановление перезапускает Jellyfin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份会保存此服务器的数据库和元数据。恢复备份会重启 Jellyfin。"
          }
        }
      }
    },
