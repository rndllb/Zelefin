    "Hold banners back while you are using Zelefin or watching something in the app. Alerts still arrive when the app is closed, outside quiet hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجّل اللافتات أثناء استخدام Zelefin أو المشاهدة داخل التطبيق. تصل التنبيهات عندما يكون التطبيق مغلقًا، خارج ساعات الهدوء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banner zurückhalten, während Sie Zelefin nutzen oder in der App etwas ansehen. Hinweise kommen weiterhin, wenn die App geschlossen ist, außerhalb der Ruhezeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold banners back while you are using Zelefin or watching something in the app. Alerts still arrive when the app is closed, outside quiet hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retén los avisos mientras usas Zelefin o ves algo en la app. Las alertas siguen llegando con la app cerrada, fuera de las horas de silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retenez les bannières pendant que vous utilisez Zelefin ou regardez quelque chose dans l’app. Les alertes arrivent encore quand l’app est fermée, hors des heures calmes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefin का उपयोग करते या ऐप में कुछ देखते समय बैनर रोकें। ऐप बंद होने पर, शांत घंटों के बाहर सूचनाएँ फिर भी आती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan spanduk saat Anda memakai Zelefin atau menonton sesuatu di aplikasi. Peringatan tetap masuk saat aplikasi tertutup, di luar jam tenang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelefin の使用中やアプリで再生中はバナーを出さない。アプリを閉じているとき、おやすみ時間の外では通知が届きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure os avisos enquanto você usa o Zelefin ou assiste a algo no app. Os alertas ainda chegam com o app fechado, fora do horário silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не показывайте баннеры, пока вы пользуетесь Zelefin или смотрите что-то в приложении. Уведомления всё равно приходят, когда приложение закрыто, вне тихих часов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Zelefin 或在应用中观看时暂不显示横幅。应用关闭后，安静时段之外仍会收到提醒。"
          }
        }
      }
    },
    "Home Network" : {

    },
    "Home rows, library catalogs, and title pages. Auto-refresh pulls anything this device has not cached yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفوف الرئيسية وفهارس المكتبة وصفحات العناوين. يجلب التحديث التلقائي ما لم يخزّنه هذا الجهاز بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startzeilen, Bibliothekskataloge und Titelseiten. Die automatische Aktualisierung holt, was dieses Gerät noch nicht zwischengespeichert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home rows, library catalogs, and title pages. Auto-refresh pulls anything this device has not cached yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filas de inicio, catálogos de biblioteca y páginas de títulos. La actualización automática trae lo que este dispositivo aún no ha guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangées d’accueil, catalogues et pages de titres. L’actualisation automatique récupère ce que cet appareil n’a pas encore mis en cache."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम पंक्तियाँ, लाइब्रेरी सूचियाँ और शीर्षक पृष्ठ। स्वतः रीफ़्रेश वह सब लाता है जिसे इस डिवाइस ने अभी कैश नहीं किया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris beranda, katalog perpustakaan, dan halaman judul. Penyegaran otomatis mengambil apa pun yang belum di-cache perangkat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームの行、ライブラリ一覧、作品ページ。自動更新は、このデバイスがまだキャッシュしていないものを取得します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fileiras da início, catálogos e páginas de títulos. A atualização automática busca o que este dispositivo ainda não armazenou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ряды главной, каталоги библиотек и страницы названий. Автообновление загружает то, чего ещё нет в кэше этого устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主页行、资料库目录和标题页面。自动刷新会拉取此设备尚未缓存的内容。"
          }
        }
      }
    },
