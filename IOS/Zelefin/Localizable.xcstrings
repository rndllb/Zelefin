    "Continue Watching, recommendations, and watched flags follow the selected profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متابعة المشاهدة والتوصيات وعلامات المشاهدة تتبع الملف الشخصي المحدد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiterschauen, Empfehlungen und Gesehen-Markierungen folgen dem ausgewählten Profil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue Watching, recommendations, and watched flags follow the selected profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar viendo, las recomendaciones y las marcas de visto siguen el perfil seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprendre, les recommandations et les marques « vu » suivent le profil sélectionné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखना जारी रखें, सुझाव और देखे जाने के चिह्न चुनी हुई प्रोफ़ाइल का अनुसरण करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanjutkan menonton, rekomendasi, dan tanda sudah ditonton mengikuti profil yang dipilih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続きから再生、おすすめ、視聴済みマークは選択中のプロフィールに従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar assistindo, as recomendações e as marcas de assistido seguem o perfil selecionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Продолжить просмотр», рекомендации и отметки просмотра зависят от выбранного профиля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续观看、推荐和已观看标记跟随所选档案。"
          }
        }
      }
    },
